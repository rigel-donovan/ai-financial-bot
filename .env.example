# ==========================================
# 📊 GOOGLE SHEETS DATABASE
# ==========================================
# ID spreadsheet Google Sheet (diambil dari URL browser)
# Contoh: https://docs.google.com/spreadsheets/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms/edit -> ID adalah 1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms
GOOGLE_SHEET_ID=your_spreadsheet_id_here

# Opsi 1: Isi seluruh isi JSON Service Account dalam 1 baris string (Direkomendasikan untuk Vercel)
# Contoh: {"type": "service_account", "project_id": "...", "private_key_id": "...", ...}
GOOGLE_SERVICE_ACCOUNT_JSON=

# Opsi 2: Pisah email & private key (Alternatif jika tidak memakai GOOGLE_SERVICE_ACCOUNT_JSON)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC6...\n-----END PRIVATE KEY-----\n"

# ==========================================
# 🤖 GOOGLE GEMINI AI (Financial Advisor)
# ==========================================
# Dapatkan gratis di https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# 💬 WHATSAPP CLOUD API (Meta for Developers)
# ==========================================
# Dapatkan di https://developers.facebook.com > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
# Token acak buatan sendiri untuk verifikasi Webhook di Meta Developer portal
WHATSAPP_VERIFY_TOKEN=my_custom_secret_verify_token_12345
# App Secret dari App Dashboard > Settings > Basic (Opsional untuk validasi signature)
WHATSAPP_APP_SECRET=

# ==========================================
# 🔒 SECURITY & ACCESS CONTROL
# ==========================================
# Nomor WhatsApp pribadi Anda (hanya nomor ini yang bisa kirim perintah ke bot)
# Format internasional tanpa tanda '+': contoh 6281234567890
ALLOWED_PHONE_NUMBER=6281234567890

# Token rahasia untuk memproteksi endpoint cron (/api/cron/recurring)
# Buat string acak sembarang, contoh: cron_secret_abc123xyz
CRON_SECRET=your_random_cron_secret_here

# ==========================================
# ✈️ TELEGRAM BOT (Opsional, Bebas Blokir & Instant)
# ==========================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
